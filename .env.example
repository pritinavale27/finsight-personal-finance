# ==============================================================================
# FINSIGHT - ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to '.env' in both root or subdirectories as instructed below.
# DO NOT commit real API secrets or credentials to public Git repositories!

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (client/.env)
# ------------------------------------------------------------------------------
# Base API URL pointing to the Express Backend Service
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Anonymous Client Config (Public Key - restricted by RLS)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
# Backend Service Environment
NODE_ENV=development
PORT=5000

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Supabase Service Role Key (Server-Side ONLY - Never expose to frontend!)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Direct Connection String (PostgreSQL)
DATABASE_URL=postgresql://postgres:your-password@db.your-supabase-project-id.supabase.co:5432/postgres

# AI Provider API Configuration (Server-Side ONLY)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-provider-api-key-here
