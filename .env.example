# ==============================================================================
# FINSIGHT - ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================================
# IMPORTANT: This file is committed to Git as a template only.
# Do NOT put real secrets here. Real secrets go in the .env.local files below.
#
# Setup instructions:
#   Frontend  →  copy client/.env.local and fill in your Supabase values
#   Backend   →  copy server/.env and fill in your backend values

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (client/.env.local)
# ------------------------------------------------------------------------------
# HOW TO FIND THESE:
#   1. Go to https://supabase.com → open your project
#   2. Navigate to: Project Settings → API
#   3. Copy "Project URL" and "anon / public" key
#
# ⚠️  SECURITY: ONLY use the anon/public key here. NEVER the service_role key.

# Base API URL pointing to the Express Backend Service
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Anonymous Client Config (Public Key — safe for frontend, restricted by RLS)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJyour-supabase-anon-key-here

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
# Backend Service Environment
NODE_ENV=development
PORT=5000

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Supabase Service Role Key (Server-Side ONLY — ⚠️ NEVER expose to the frontend!)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Direct Connection String (PostgreSQL)
DATABASE_URL=postgresql://postgres:your-password@db.your-supabase-project-id.supabase.co:5432/postgres

# AI Provider API Configuration (Server-Side ONLY)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-provider-api-key-here

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION NOTES
# ------------------------------------------------------------------------------
# Email confirmation:
#   - Enabled by default in new Supabase projects.
#   - To disable for easier local dev: Dashboard → Authentication → Email → uncheck "Confirm email"
#
# Redirect URLs (for password reset + email confirmation):
#   - Local dev: add http://localhost:5173 in Dashboard → Authentication → URL Configuration
#   - Production: add your production domain when you deploy
